<Page x:Class="WPF1.Pages.AncetaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AncetaPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Анкета"
           Grid.Column="2"
           Grid.ColumnSpan="2"
           FontSize="25"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>
        <StackPanel
            Grid.Column="1"
            Grid.Row="1"
            Grid.ColumnSpan="4"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" Margin="0,11,0,0">
            <TextBlock Text="Имя:"
               FontSize="25"
               FontWeight="Heavy"/>
            <TextBox Name="Name"
             Width="200"
             Height="25"
             Margin="100 0 0 0"
             Background="IndianRed"/>
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Grid.Row="2"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock Text="Пол:"
                       FontSize="25"
                       FontWeight="Heavy"/>
            <RadioButton GroupName="Gender"
                         Content="Мужской"
                         FontSize="25"
                         FontWeight="DemiBold"/>
            <RadioButton GroupName="Gender"
                         Content="Женский"
                         FontSize="25"/>
        </StackPanel>
        <StackPanel Grid.Column="0"
                    Grid.Row="3"
                    Grid.ColumnSpan="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock Text="Дата рождения:"
                       FontSize="25"
                       FontWeight="Heavy"/>
            <DatePicker/>
            <TextBlock Text="Любимое животное"
                       FontSize="25"
                       FontWeight="Heavy"/>
            <ComboBox>
                <TextBlock>Собака</TextBlock>
                <TextBlock>Кот</TextBlock>
                <TextBlock>Крокодил</TextBlock>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="0"
                    Grid.Row="4"
                    Grid.ColumnSpan="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <TextBlock Text="Студент:"
                       FontSize="25"
                       FontWeight="Heavy"/>
            <CheckBox IsChecked="False" Height="20" Width="20"></CheckBox>
        </StackPanel>
        <StackPanel Grid.Column="0"
                    Grid.Row="5"
                    Grid.ColumnSpan="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <Image Source="C:\Users\User\source\repos\WPF1\WPF1\Pages\Image\Photo.jpg"
                   Width="75"
                   Height="75"/>
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Grid.Row="5"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock FontWeight="Heavy">Любимые книги:</TextBlock>
            <ListView>
                <TextBlock>"1984" Джордж Оруелл</TextBlock>
                <TextBlock>"Метро 2033" Дмитрий Глуховский</TextBlock>
                <TextBlock>"Капитанская дочка" Александр Пушкни</TextBlock>
                <TextBlock>"Перси ДЖексон и повелитель молний" Рик Риордан Джордж Оруелл</TextBlock>
            </ListView>
            
        </StackPanel>

    </Grid>
</Page>
