<Page x:Class="WPF1.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Авторизация"
                   Grid.Column="1"
                   Grid.Row="1"
                   Grid.ColumnSpan="4"
                   FontSize="35"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <StackPanel Name="Login"
                    Grid.Column="1"
                    Grid.Row="2"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Логин:"
                       FontSize="25"
                       FontWeight="Heavy"/>
            <TextBox Name="LoginTB"
                     Width="200"
                     Height="25"
                     Margin="100 0 0 0"
                     Background="IndianRed"/>
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Grid.Row="3"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            
             <TextBlock Text="Пароль:"
                        FontSize="25"
                        FontWeight="Heavy"/>
            <PasswordBox Name="PasswordPB" 
                         Width="200"
                         Height="25"
                         Margin="80 0 0 0"
                         Background="Magenta"/>
        </StackPanel>
        <Button Name="LoginButton"
                Content="Войти"
                FontSize="25"
                FontWeight="Bold"
                Click="LoginButton_Click"
                Grid.Column="2"
                Grid.Row="4"
                Grid.ColumnSpan="2"
                Width="100"
                Height="40"
                Background="Aqua"/>



    </Grid>
</Page>
